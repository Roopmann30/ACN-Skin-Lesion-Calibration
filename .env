# Server Port (default: 3000)
PORT=3000

# Built-in Node.js ACN calibration engine is used when ML_SERVICE_URL is unset.
# To connect external Python PyTorch service, set ML_SERVICE_URL="http://127.0.0.1:8000"
ML_SERVICE_URL=""

# APP_URL: Public URL where the app is hosted.
APP_URL="http://localhost:3000"
